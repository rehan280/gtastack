  },
  {
    id: 'heavy-rifle',
    type: 'standard',
    title: 'Heavy Rifle',
    manufacturer: 'Vom Feuer',
    category: 'Assault Rifle',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAWv8W2xNpt4_sTOO_-ufElqqmNJI44XwDNbZ7aauh4XedQTL8S6-qy3nvEWnhHjxx0vGlmxk1Mi5YVAh1AbqVIq7CfYsE0tD42i0Bb_w0qiBLJMz6Vtna_LwV5pLb0HrbPf7XAlA3xlRLLw8aEOS3IyzaPW1yQWB2BMdHGmVyfN-ZJlWi0o4Y4lsXWtWIuLhgcsYvHZtCtJ8KPxSCVBXE__So_J0dQ9rpYcLd-pPQB6VjaJzNSWMzYOQK-2cwtwJwvMFT8Lx_7HqM',
    price: '¢45,000',
    icon: 'swords',
    iconColor: 'text-[#ff3333]',
    tag: { text: 'RESTRICTED', class: 'bg-[#ff3333]/20 text-[#ff3333] border-[#ff3333] shadow-[0_0_10px_rgba(255,51,51,0.5)]' },
    hoverBorderClass: 'hover:border-[#ff3333]',
    stats: [
      { label: 'DMG', gaugeLevel: 7, gaugeColor: 'error' },
      { label: 'FR', gaugeLevel: 6, gaugeColor: 'primary' },
      { label: 'ACC', gaugeLevel: 8, gaugeColor: 'secondary' }
    ]
  },
  {
    id: 'bati-801',
    type: 'standard',
    title: 'Bati 801',
    manufacturer: 'Pegassi',
    category: 'Motorcycle',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuApbSze6veP7ZLDLyMGIGSi4VsQ-l7BkkL_W9b-8zw4aPCPb6vpa7egi-CHIL7v-VHJYnATlTf0wBVFHk6JIOtOp_gmuBPZhxrTMavz8eI1i_MxCoj3YHGH06RuhS3m59Ld6HBSdXCaMFe2VCVBz97GtiVA3FVPnnoESk-ZDAp6Y3DAhO6A-k2pJS2mOr_OCSLWlDljX28iRVPraEvCBjT5J4Uxv-4JqT97D1ATqYIqkZyqlsm9rVmd0FEbaDyZEf0hbTTs_myG9hg',
    price: '¢15,000',
    icon: 'two_wheeler',
    iconColor: 'text-primary',
    tag: undefined,
