---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';

interface AssetCard {
  id: string;
  type: 'featured' | 'standard';
  title: string;
  manufacturer: string;
  category: string;
  image: string;
  price: string;
  icon: string;
  iconColor: string;
  description?: string;
  tag?: { text: string; class: string; };
  stats: {
    label: string;
    value?: string;
    gaugeLevel?: number;
    gaugeColor?: 'primary' | 'secondary' | 'tertiary' | 'error';
