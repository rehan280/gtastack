---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';

const weatherData = [
  { label: 'CURRENT WEATHER', value: 'Stormy', icon: 'thunderstorm', colorClass: 'text-secondary', dropShadow: 'drop-shadow-[0_0_8px_rgba(0,238,252,0.8)]' },
  { label: 'TEMPERATURE', value: '82°F', icon: 'thermostat', colorClass: 'text-primary', dropShadow: 'drop-shadow-[0_0_8px_rgba(255,0,189,0.8)]' },
  { label: 'TIME', value: '23:45', icon: 'schedule', colorClass: 'text-white', dropShadow: '' },
  { label: 'VISIBILITY', value: 'Low', icon: 'visibility_off', colorClass: 'text-[#ff3333]', dropShadow: 'drop-shadow-[0_0_8px_rgba(255,51,51,0.8)]' }
];

const districts = [
  { name: 'Vice City Metro', selected: false },
  { name: 'Leonida Keys', selected: true },
  { name: 'Ambrosia', selected: false },
  { name: 'Kelly County', selected: false }
];

const districtData = {
  name: 'LEONIDA KEYS',
  threatLevel: 'MODERATE',
  icon: 'sailing',
  stats: [
    { label: 'Controlling Faction', value: 'Cartel', valueColor: 'text-white' },
    { label: 'Known Safehouses', value: '3', valueColor: 'text-white' },
    { label: 'Vehicle Density', value: 'High (Watercraft)', valueColor: 'text-secondary' },
    { label: 'Police Presence', value: 'Low', valueColor: 'text-white' }
  ],
  exploration: 42
};

const recentLogs = [
  { title: 'Gator Keys Stash House', meta: 'Added by x_Ghost_x • 2h ago', hoverColor: 'hover:border-primary group-hover:text-primary' },
  { title: 'Marina Weapon Spawn', meta: 'Verified by System • 5h ago', hoverColor: 'hover:border-secondary group-hover:text-secondary' },
  { title: 'Bridge Toll Bypass', meta: 'Updated by OPERATIVE • 1d ago', hoverColor: 'hover:border-primary group-hover:text-primary' }
];

const mapPins = [
  { top: '25%', left: '33.33%', label: 'Vice Point', color: 'primary' },
  { top: '50%', left: '75%', label: 'Ocean Beach Safehouse', color: 'secondary' }
];
---

<Layout title="Leonida Territory Map | GTA STACK">

  <div class="flex flex-1 overflow-hidden">
    <Sidebar />

    <main class="flex-1 overflow-y-auto" role="main">
      <div class="w-full max-w-[1440px] mx-auto px-4 md:px-8 py-8 relative z-10">
        
        <!-- Header Section -->
        <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <span class="material-symbols-outlined text-primary text-3xl drop-shadow-[0_0_8px_rgba(255,0,189,0.8)]" style="font-variation-settings: 'FILL' 1;">map</span>
              <h2 class="font-headline-lg text-[32px] md:text-[40px] text-on-surface uppercase tracking-tight glitch-text" data-text="LEONIDA TERRITORY">LEONIDA TERRITORY</h2>
            </div>
            <p class="font-data-label text-[12px] text-on-surface-variant max-w-2xl leading-relaxed">Geospatial intelligence and live territory metrics for the greater Leonida state. Access district data, safehouses, and high-value target zones.</p>
          </div>
          <div class="flex gap-4">
            <div class="bg-surface-container/80 border border-[#333340] backdrop-blur-xl px-4 py-2 rounded-sm flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[18px]">cell_tower</span>
              <span class="font-data-label text-[12px] text-primary uppercase tracking-widest">LIVE DATA</span>
            </div>
          </div>
        </div>

        <!-- Grid Layout -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
          
          <!-- Main Map Module (Span 8) -->
          <div class="xl:col-span-8 flex flex-col gap-6">
            <!-- The Map Container -->
            <div class="terminal-card rounded-sm h-[600px] flex flex-col group bg-surface-container/50">
              <div class="terminal-header px-4 py-2 flex items-center justify-between z-10 bg-[#1a1a1f]/50">
                <div class="flex gap-2">
                  <button class="bg-[#1a1a1f]/50 border border-[#333340] text-white font-data-label text-[10px] px-3 py-1 rounded-sm hover:border-primary transition-colors flex items-center gap-1 uppercase tracking-widest">
                    <span class="material-symbols-outlined text-[14px]">layers</span> LAYERS
                  </button>
                  <button class="bg-[#1a1a1f]/50 border border-[#333340] text-white font-data-label text-[10px] px-3 py-1 rounded-sm hover:border-primary transition-colors flex items-center gap-1 uppercase tracking-widest">
                    <span class="material-symbols-outlined text-[14px]">filter_alt</span> FILTER
                  </button>
                </div>
                <div class="font-data-label text-[10px] text-secondary uppercase tracking-widest flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-secondary shadow-[0_0_10px_rgba(0,238,252,1)] animate-pulse"></span>
                  SYNCED: 0.2s AGO
                </div>
              </div>
              
              <div class="relative flex-1 overflow-hidden">
                <!-- Map Image Placeholder -->
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 group-hover:scale-105" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBnlsedcE72QTDzRRgmcBPrZxnyUpV_Qx5npLM96LeSYxbHDeFRa4vYw68H4mwPY5uUJx1JIMf9-qPmVrtgw31cmcKylhBEgonMdzRqFrXi6FMt42Bgtz-FB4Hi8m4th40fKekDf7I1OOiYRmnavkLIzIz87xtbnxokuxgyejKcLMZJAJhj99v0djrFUdISSw4doVcG8zs5izkiqOPBZFxesTGJDuJEHR6UIHakHffYq2BerpOoeXFW6gI4LpGWwK37J6DhUClNFqU')">
                  <!-- Overlay to dim background slightly -->
                  <div class="absolute inset-0 bg-[#0a0a0c]/60"></div>
                </div>
                
                {mapPins.map(pin => (
                  <div class="absolute z-10 cursor-pointer group/pin" style={{ top: pin.top, left: pin.left }}>
                    <div class={`w-4 h-4 rounded-full ${pin.color === 'primary' ? 'bg-primary shadow-[0_0_15px_rgba(255,0,189,0.8)]' : 'bg-secondary shadow-[0_0_15px_rgba(0,238,252,0.8)]'} border-2 border-[#0a0a0c] relative z-20`}></div>
                    <div class={`absolute -top-10 left-1/2 -translate-x-1/2 bg-[#121215] border ${pin.color === 'primary' ? 'border-primary/50 shadow-[0_0_10px_rgba(255,0,189,0.2)]' : 'border-secondary/50 shadow-[0_0_10px_rgba(0,238,252,0.2)]'} text-white font-data-label text-[10px] px-2 py-1 rounded-sm opacity-0 group-hover/pin:opacity-100 transition-opacity whitespace-nowrap backdrop-blur-md uppercase tracking-widest`}>{pin.label}</div>
                  </div>
                ))}

                <!-- Map UI Overlay: Bottom Controls -->
                <div class="absolute bottom-4 right-4 flex flex-col gap-2 z-10">
                  <button class="w-8 h-8 bg-[#1a1a1f]/80 backdrop-blur-md border border-[#333340] rounded-sm flex items-center justify-center text-white hover:border-primary transition-colors">
                    <span class="material-symbols-outlined">add</span>
                  </button>
                  <button class="w-8 h-8 bg-[#1a1a1f]/80 backdrop-blur-md border border-[#333340] rounded-sm flex items-center justify-center text-white hover:border-primary transition-colors">
                    <span class="material-symbols-outlined">remove</span>
                  </button>
                  <button class="w-8 h-8 mt-2 bg-primary/20 backdrop-blur-md border border-primary/50 rounded-sm flex items-center justify-center text-primary hover:bg-primary/30 transition-colors shadow-[0_0_10px_rgba(255,0,189,0.2)]">
                    <span class="material-symbols-outlined">my_location</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Weather & Environment Module -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              {weatherData.map(data => (
                <div class="terminal-card rounded-sm p-4 flex flex-col bg-surface-container/50">
                  <div class="font-data-label text-[10px] text-on-surface-variant uppercase tracking-widest mb-2">{data.label}</div>
                  <div class="flex items-center gap-3">
                    <span class={`material-symbols-outlined text-[24px] ${data.colorClass} ${data.dropShadow}`}>{data.icon}</span>
                    <span class="font-stat-value text-[20px] text-white">{data.value}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Side Data Panel (Span 4) -->
          <div class="xl:col-span-4 flex flex-col gap-6">
            
            <!-- Region Selector -->
            <div class="terminal-card rounded-sm flex flex-col bg-surface-container/50">
              <div class="terminal-header px-4 py-3 flex items-center justify-between bg-[#1a1a1f]/50">
                <h2 class="font-data-label text-[12px] text-secondary-container uppercase tracking-widest">&gt; DISTRICT SELECT</h2>
              </div>
              <div class="p-4 flex flex-col gap-2 font-data-label text-[12px] uppercase tracking-wider">
                {districts.map(district => (
                  district.selected ? (
                    <button class="w-full text-left bg-primary/10 border border-primary p-3 rounded-sm text-primary flex justify-between items-center shadow-[inset_0_0_20px_rgba(255,0,189,0.1)]">
                      {district.name}
                      <span class="material-symbols-outlined text-primary text-[16px]">my_location</span>
                    </button>
                  ) : (
                    <button class="w-full text-left bg-[#1a1a1f]/50 border border-[#333340] p-3 rounded-sm text-white hover:border-primary/50 hover:bg-[#23232a]/50 transition-all flex justify-between items-center group">
                      {district.name}
                      <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors text-[16px]">chevron_right</span>
                    </button>
                  )
                ))}
              </div>
            </div>

            <!-- Selected District Data Card -->
            <div class="terminal-card rounded-sm flex-1 flex flex-col p-6 bg-surface-container/50">
              <div class="flex justify-between items-start mb-6">
                <div>
                  <h3 class="font-headline-lg text-[24px] uppercase leading-tight text-white">{districtData.name}</h3>
                  <div class="font-data-label text-[10px] text-[#ff3333] mt-1 uppercase tracking-widest border border-[#ff3333]/30 inline-block px-2 py-0.5 bg-[#ff3333]/10">THREAT LEVEL: {districtData.threatLevel}</div>
                </div>
                <div class="w-10 h-10 rounded-sm bg-[#121215] border border-[#333340] flex items-center justify-center">
                  <span class="material-symbols-outlined text-secondary">{districtData.icon}</span>
                </div>
              </div>
              
              <div class="space-y-4 mb-8">
                {districtData.stats.map(stat => (
                  <div class="flex justify-between items-center border-b border-[#333340] pb-2">
                    <span class="font-data-label text-[10px] uppercase tracking-widest text-on-surface-variant">{stat.label}</span>
                    <span class={`font-data-label text-[12px] ${stat.valueColor}`}>{stat.value}</span>
                  </div>
                ))}
              </div>

              <!-- Territory Progress Bar -->
              <div class="mt-auto">
                <div class="flex justify-between font-data-label text-[10px] mb-2 text-on-surface-variant uppercase tracking-widest">
                  <span>EXPLORATION</span>
                  <span>{districtData.exploration}%</span>
                </div>
                <div class="hud-gauge h-2">
                  {Array.from({length: 10}).map((_, i) => (
                    <div class={`hud-gauge-segment ${i < Math.floor(districtData.exploration / 10) ? 'active-primary' : ''}`}></div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Recent Logs -->
            <div class="terminal-card rounded-sm flex flex-col bg-surface-container/50">
              <div class="terminal-header px-4 py-2 flex items-center justify-between bg-[#1a1a1f]/50">
                <span class="font-data-label text-[10px] text-on-surface-variant uppercase tracking-widest">&gt; RECENTLY UPDATED</span>
              </div>
              <div class="p-4 flex flex-col gap-3">
                {recentLogs.map(log => (
                  <div class={`flex gap-3 group cursor-pointer border-l-2 border-transparent pl-2 transition-colors ${log.hoverColor}`}>
                    <div class="flex-1">
                      <div class={`font-data-label text-[12px] text-white transition-colors ${log.hoverColor.split(' ')[1]}`}>{log.title}</div>
                      <div class="font-data-label text-[10px] text-on-surface-variant">{log.meta}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
