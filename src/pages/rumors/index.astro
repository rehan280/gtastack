---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';

interface RumorPost {
  id: string;
  status: 'DEBUNKED' | 'PLAUSIBLE' | 'CONFIRMED';
  statusColorClass: string;
  author: string;
  timeAgo: string;
  sourceCred: string;
  sourceCredColorClass: string;
  title: string;
  content: string;
  upvotes: string;
  comments: string;
  image?: string;
}

const rumors: RumorPost[] = [
  {
    id: 'r1',
    status: 'PLAUSIBLE',
    statusColorClass: 'text-secondary bg-secondary/10 border-secondary',
    author: 'Leakz0r99',
    timeAgo: '2 hours ago',
    sourceCred: 'HIGH',
    sourceCredColorClass: 'text-[#00ff88]',
    title: 'Dual-Wielding Confirmed in Recent Build',
    content: 'According to a newly surfaced string in the engine codebase (weapon_dual_wield_anim_sync), players will be able to dual-wield sidearms and micro-SMGs. This is a return to San Andreas style mechanics, but with independent targeting.',
    upvotes: '1.2k',
    comments: '342'
  },
  {
    id: 'r2',
    status: 'DEBUNKED',
    statusColorClass: 'text-[#ff3333] bg-[#ff3333]/10 border-[#ff3333]',
    author: 'Anonymous',
    timeAgo: '5 hours ago',
    sourceCred: 'LOW',
    sourceCredColorClass: 'text-[#ff3333]',
    title: 'Map Size is 3x Los Santos',
    content: 'A supposed leaked map render shows the Leonida state being roughly 3 times the size of GTA V map. However, mapping experts have analyzed the road widths and building scales and concluded the image is AI-generated.',
    upvotes: '456',
    comments: '89'
  },
  {
    id: 'r3',
    status: 'CONFIRMED',
    statusColorClass: 'text-primary bg-primary/10 border-primary',
    author: 'System',
    timeAgo: '1 day ago',
    sourceCred: 'OFFICIAL',
    sourceCredColorClass: 'text-primary',
    title: 'Dynamic Hair Growth System',
    content: 'As seen in the official Trailer 1, character hair will grow dynamically over time similar to RDR2. Barbershops will be required to maintain specific cuts.',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDFH12g3eX4l4L4c1C3Jq3Hq2m9h3qXp4A9l3d4C0B6q3F9q9q7D4k9R7T7R4C4w1K9D9D9G0V1r1a3X3B8B8D2V2W2B8a9A1f4N9a3x3M0D0A0Z0B2A9Z9M9m0X0H1n9v3T0W2m0t9e4S0j9z8H4d0Z9q2',
    upvotes: '4.5k',
    comments: '1.2k'
  }
];

const hotTheories = [
  { rank: 1, title: 'The "Project Americas" timeline gap', color: 'text-primary' },
  { rank: 2, title: 'Lucia\'s ankle monitor mechanics', color: 'text-secondary' },
  { rank: 3, title: 'Return of the Malibu Club', color: 'text-white' }
];
---

<Layout title="Rumor Mill & Leaks | GTA STACK">

  <div class="flex flex-1 overflow-hidden">
    <Sidebar />

    <main class="flex-1 overflow-y-auto" role="main">
      <div class="w-full max-w-[1440px] mx-auto px-4 md:px-8 py-8 relative z-10">
        
        <!-- Header Section -->
        <div class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <span class="material-symbols-outlined text-primary text-3xl drop-shadow-[0_0_8px_rgba(255,0,189,0.8)]">forum</span>
              <h2 class="font-headline-lg text-[32px] md:text-[40px] text-on-surface uppercase tracking-tight glitch-text" data-text="THE RUMOR MILL">THE RUMOR MILL</h2>
            </div>
            <p class="font-data-label text-[12px] text-on-surface-variant max-w-2xl leading-relaxed">Unverified intel, community theories, and leaked data streams. All information here is subject to change and should be treated with extreme skepticism unless marked 'CONFIRMED'.</p>
          </div>
          
          <!-- Controls -->
          <div class="flex gap-2 font-data-label text-[10px] uppercase tracking-widest">
            <button class="bg-primary/10 border border-primary text-primary px-4 py-2 rounded-sm shadow-[0_0_10px_rgba(255,0,189,0.2)] transition-colors flex items-center gap-2">
              <span class="material-symbols-outlined text-[14px]">local_fire_department</span> HOT
            </button>
            <button class="bg-[#1a1a1f]/50 border border-[#333340] text-on-surface-variant hover:border-secondary hover:text-secondary px-4 py-2 rounded-sm transition-all flex items-center gap-2">
              <span class="material-symbols-outlined text-[14px]">new_releases</span> NEW
            </button>
            <button class="bg-[#1a1a1f]/50 border border-[#333340] text-on-surface-variant hover:text-white px-4 py-2 rounded-sm transition-all flex items-center gap-2">
              <span class="material-symbols-outlined text-[14px]">filter_list</span> FILTER
            </button>
          </div>
        </div>

        <!-- Layout Grid -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-8">
          
          <!-- Feed (Span 8) -->
          <div class="xl:col-span-8 flex flex-col gap-6">
            
            <!-- Submit Prompt -->
            <div class="terminal-card rounded-sm p-4 flex items-center gap-4 bg-surface-container/50 border border-primary/30 shadow-[0_0_15px_rgba(255,0,189,0.1)]">
              <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center border border-primary shrink-0">
                <span class="material-symbols-outlined text-primary">add</span>
              </div>
              <input type="text" placeholder="Submit new intel or theory..." class="bg-transparent border-none outline-none text-on-surface font-data-label text-[14px] w-full placeholder:text-on-surface-variant focus:ring-0">
            </div>

            <!-- Rumor Posts -->
            <div class="space-y-6">
              {rumors.map(rumor => (
                <article class="terminal-card rounded-sm flex flex-col group transition-all hover:border-secondary/50 bg-surface-container/50">
                  <div class="p-6">
                    <div class="flex justify-between items-start mb-4">
                      <div class="flex items-center gap-3">
                        <span class={`border px-2 py-1 font-data-label text-[10px] font-bold uppercase tracking-widest rounded-sm ${rumor.statusColorClass}`}>{rumor.status}</span>
                        <span class="font-data-label text-[10px] text-on-surface-variant uppercase tracking-widest">Posted by <span class="text-white">{rumor.author}</span> • {rumor.timeAgo}</span>
                      </div>
                      <div class="font-data-label text-[10px] uppercase tracking-widest text-on-surface-variant border border-[#333340] px-2 py-1 rounded-sm bg-[#1a1a1f]/50">
                        SRC CREDIBILITY: <span class={rumor.sourceCredColorClass}>{rumor.sourceCred}</span>
                      </div>
                    </div>
                    
                    <h3 class="font-headline-lg text-[24px] text-on-surface uppercase leading-tight mb-3 group-hover:text-secondary transition-colors">{rumor.title}</h3>
                    
                    <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed mb-4">
                      {rumor.content}
                    </p>
                    
                    {rumor.image && (
                      <div class="w-full h-48 rounded-sm overflow-hidden border border-[#333340] mb-4">
                        <img src={rumor.image} alt="Evidence" class="w-full h-full object-cover filter contrast-125 brightness-90">
                      </div>
                    )}
                    
                    <div class="flex items-center gap-6 mt-4 pt-4 border-t border-[#333340]">
                      <button class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors font-data-label text-[12px]">
                        <span class="material-symbols-outlined text-[16px]">keyboard_double_arrow_up</span> {rumor.upvotes}
                      </button>
                      <button class="flex items-center gap-2 text-on-surface-variant hover:text-secondary transition-colors font-data-label text-[12px]">
                        <span class="material-symbols-outlined text-[16px]">chat_bubble</span> {rumor.comments}
                      </button>
                      <button class="flex items-center gap-2 text-on-surface-variant hover:text-white transition-colors font-data-label text-[12px] ml-auto">
                        <span class="material-symbols-outlined text-[16px]">share</span> SHARE
                      </button>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <!-- Load More Button -->
            <div class="mt-8 flex justify-center">
              <button class="bg-transparent border border-[#333340] text-on-surface-variant hover:border-primary hover:text-primary transition-all font-data-label text-[12px] uppercase tracking-widest px-8 py-3 rounded-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px]">sync</span> Fetching Older Intel...
              </button>
            </div>
          </div>

          <!-- Sidebar (Span 4) -->
          <div class="xl:col-span-4 flex flex-col gap-6">
            
            <!-- Hot Theories Widget -->
            <div class="terminal-card rounded-sm flex flex-col bg-surface-container/50">
              <div class="terminal-header px-4 py-3 flex items-center justify-between bg-[#1a1a1f]/50 border-b border-[#333340]">
                <h2 class="font-data-label text-[12px] text-secondary uppercase tracking-widest flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px]">trending_up</span> HOT THEORIES
                </h2>
              </div>
              <div class="p-0 flex flex-col">
                {hotTheories.map(theory => (
                  <button class="text-left p-4 border-b border-[#333340] hover:bg-[#1a1a1f]/50 transition-colors group flex items-start gap-4 last:border-0">
                    <span class={`font-headline-lg text-[20px] ${theory.color}`}>0{theory.rank}</span>
                    <div>
                      <h4 class="font-data-label text-[12px] text-on-surface uppercase leading-tight group-hover:text-primary transition-colors">{theory.title}</h4>
                      <span class="font-data-label text-[10px] text-on-surface-variant mt-1 uppercase">Trending in Community</span>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <!-- Warning Notice -->
            <div class="terminal-card p-4 border border-[#ff3333]/30 bg-[#ff3333]/5 rounded-sm relative overflow-hidden">
               <div class="absolute top-0 left-0 w-1 h-full bg-[#ff3333]"></div>
               <div class="flex items-start gap-3">
                 <span class="material-symbols-outlined text-[#ff3333]">warning</span>
                 <div>
                   <h4 class="font-data-label text-[10px] text-[#ff3333] uppercase tracking-widest mb-1">DISCLAIMER</h4>
                   <p class="font-data-label text-[10px] text-on-surface-variant leading-relaxed">
                     Do not solicit or post illegally obtained proprietary data. The GTA STACK aggregates publically accessible rumors. We do not host raw stolen files.
                   </p>
                 </div>
               </div>
            </div>

          </div>

        </div>
      </div>
    </main>
  </div>
</Layout>
