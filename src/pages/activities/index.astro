---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';

interface DailyMiniGame {
  id: string;
  title: string;
  status: string;
  statusClass: string;
  icon: string;
  iconColorClass: string;
  hoverBorderClass: string;
  target?: string;
  bounties?: string;
  signal?: string;
  reward: string;
  extraDetail?: {
    type: 'time' | 'link' | 'progress';
    value: string;
    icon?: string;
    progressWidth?: string;
  };
  hasBlur?: boolean;
}

const dailyMiniGames: DailyMiniGame[] = [
  {
    id: 'chop-shop',
    title: 'Chop Shop',
    status: 'ACTIVE',
    statusClass: 'text-primary bg-primary/10 border-primary/30 shadow-[0_0_10px_rgba(255,0,189,0.2)]',
    icon: 'car_repair',
    iconColorClass: 'group-hover:text-primary',
    hoverBorderClass: 'border-t border-t-primary',
    target: 'Target: Grotti Cheetah',
    reward: '¢45,000',
    extraDetail: { type: 'time', value: '04:12:00', icon: 'schedule' },
    hasBlur: true
  },
  {
    id: 'wanted-list',
    title: 'Wanted List',
    status: 'HIGH RISK',
    statusClass: 'text-[#ff3333] bg-[#ff3333]/10 border-[#ff3333]/30 shadow-[0_0_10px_rgba(255,51,51,0.2)]',
    icon: 'local_police',
    iconColorClass: 'group-hover:text-[#ff3333]',
    hoverBorderClass: 'hover:border-[#ff3333]/50',
    bounties: 'Bounties: 3 remaining',
    reward: 'Up to ¢120k',
    extraDetail: { type: 'link', value: 'View Targets' }
  },
  {
    id: 'wiretapper',
    title: 'Wiretapper',
    status: 'INTEL',
    statusClass: 'text-tertiary bg-tertiary/10 border-tertiary/30 shadow-[0_0_10px_rgba(139,0,255,0.2)]',
    icon: 'settings_input_antenna',
    iconColorClass: 'group-hover:text-tertiary',
    hoverBorderClass: 'hover:border-tertiary/50',
    signal: 'Signal Intercept: Downtown',
    reward: 'RP +2500',
    extraDetail: { type: 'progress', value: '75%', progressWidth: 'w-3/4' }
  }
];

interface Activity {
  name: string;
  icon: string;
  colorClass: string;
  shadowClass: string;
  location: string;
  reward: string;
  rewardColorClass: string;
  buff: string;
  buffClass: string;
  statusIcon: string;
  statusClass?: string;
  bgColorClass?: string;
}

const activities: Activity[] = [
  {
    name: 'Dirt Biking Trials',
    icon: 'sports_motorsports',
    colorClass: 'group-hover:text-primary group-hover:border-primary',
    shadowClass: 'bg-primary shadow-[0_0_10px_rgba(255,0,189,0.8)]',
    location: 'Vice Point Hills',
    reward: '¢500 - ¢2000',
    rewardColorClass: 'text-[#00ff88]',
    buff: 'Stamina +',
    buffClass: 'text-primary bg-primary/10 border-primary/20',
    statusIcon: 'lock_open'
  },
  {
    name: 'Exotic Poaching',
    icon: 'cruelty_free',
    colorClass: 'group-hover:text-[#ff3333] group-hover:border-[#ff3333]',
    shadowClass: 'bg-[#ff3333] shadow-[0_0_10px_rgba(255,51,51,0.8)]',
    location: 'Leaf Links / Swamps',
    reward: 'Varies by pelt',
    rewardColorClass: 'text-[#00ff88]',
    buff: 'Stealth +',
    buffClass: 'text-[#ff3333] bg-[#ff3333]/10 border-[#ff3333]/20',
    statusIcon: 'lock_open'
  },
  {
    name: 'Street Racing (Tier 1)',
    icon: 'flag',
    colorClass: 'group-hover:text-secondary group-hover:border-secondary',
    shadowClass: 'bg-secondary shadow-[0_0_10px_rgba(0,238,252,0.8)]',
    location: 'Ocean Beach',
    reward: '¢5,000 + Pink Slip',
    rewardColorClass: 'text-[#00ff88]',
    buff: 'Driving +',
    buffClass: 'text-secondary bg-secondary/10 border-secondary/20',
    statusIcon: 'deselect',
    statusClass: 'bg-[#333340] px-2 py-1 rounded-sm text-[14px]',
    bgColorClass: 'bg-[#1a1a1f]/30'
  },
  {
    name: 'Club Tennis',
    icon: 'sports_tennis',
    colorClass: 'group-hover:text-tertiary group-hover:border-tertiary',
    shadowClass: 'bg-tertiary shadow-[0_0_10px_rgba(139,0,255,0.8)]',
    location: 'Starfish Island',
    reward: 'None (Social)',
    rewardColorClass: 'text-secondary',
    buff: 'Max Health +',
    buffClass: 'text-tertiary bg-tertiary/10 border-tertiary/20',
    statusIcon: 'lock_open'
  }
];
---

<Layout title="Activities & Mini-Games Database | GTA STACK">

  <!-- Main Content Area -->
  <div class="flex-grow flex flex-col lg:flex-row w-full max-w-[1440px] mx-auto relative pt-8 pb-16 gap-8 px-4 md:px-8 z-10">
    <Sidebar />

    <!-- Main Canvas -->
    <main class="flex-grow flex flex-col gap-12 w-full min-w-0">
      <!-- Header Section -->
      <header class="flex flex-col gap-2">
        <h1 class="font-headline-lg-mobile md:font-headline-lg text-[32px] md:text-[40px] text-on-surface uppercase tracking-tight glitch-text" data-text="Activities Database">
          Activities Database
        </h1>
        <p class="text-on-surface-variant max-w-2xl text-[14px]">
          Comprehensive ledger of side-hustles, mini-games, and illicit opportunities across Vice City. Filter by risk-reward ratios and character affinity.
        </p>
      </header>

      <!-- Daily Mini-Games (Bento Grid) -->
      <section class="flex flex-col gap-6">
        <div class="flex items-center gap-2 mb-2">
          <span class="material-symbols-outlined text-secondary">casino</span>
          <h2 class="font-data-label text-[14px] text-secondary uppercase tracking-widest">Daily Mini-Games</h2>
          <div class="h-px bg-[#333340] flex-grow ml-4"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {dailyMiniGames.map((game) => (
            <div class={`terminal-card rounded-sm flex flex-col group relative overflow-hidden h-full transition-colors ${game.hoverBorderClass}`}>
              {game.hasBlur && (
                <div class="absolute -right-10 -top-10 w-32 h-32 bg-primary/20 blur-3xl rounded-full pointer-events-none"></div>
              )}
              <div class="p-6 flex flex-col gap-4 h-full relative z-10">
                <div class="flex justify-between items-start">
                  <div>
                    <h3 class="font-stat-value text-[20px] text-on-surface uppercase mb-1 group-hover:text-white transition-colors">{game.title}</h3>
                    <div class={`font-data-label text-[10px] px-2 py-0.5 border rounded-sm inline-block uppercase tracking-wider ${game.statusClass}`}>{game.status}</div>
                  </div>
                  <span class={`material-symbols-outlined text-3xl text-on-surface-variant transition-colors ${game.iconColorClass}`}>{game.icon}</span>
                </div>
                <div class="mt-auto pt-4">
                  <div class="text-[12px] text-on-surface-variant mb-2 font-data-label">
                    {game.target && game.target}
                    {game.bounties && game.bounties}
                    {game.signal && game.signal}
                  </div>
                  <div class="flex items-center justify-between font-data-label text-[14px]">
                    <span class="text-secondary font-bold">{game.reward}</span>
                    
                    {game.extraDetail && game.extraDetail.type === 'time' && (
                      <span class="text-on-surface-variant flex items-center gap-1 text-[12px]">
                        <span class="material-symbols-outlined text-[14px]">{game.extraDetail.icon}</span> {game.extraDetail.value}
                      </span>
                    )}
                    
                    {game.extraDetail && game.extraDetail.type === 'link' && (
                      <button class="text-primary hover:text-white transition-colors uppercase text-[10px] tracking-wider border-b border-primary/30 hover:border-primary pb-0.5">
                        {game.extraDetail.value}
                      </button>
                    )}
                    
                    {game.extraDetail && game.extraDetail.type === 'progress' && (
                      <div class="w-16 h-1.5 bg-[#1a1a1f] rounded-none overflow-hidden border border-[#333340]">
                        <div class={`h-full bg-tertiary ${game.extraDetail.progressWidth} shadow-[0_0_5px_#8b00ff]`}></div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Main Database Table -->
      <section class="flex flex-col gap-6">
        <div class="flex items-center gap-2 mb-2">
          <span class="material-symbols-outlined text-primary">database</span>
          <h2 class="font-data-label text-[14px] text-primary uppercase tracking-widest">Full Directory</h2>
          <div class="h-px bg-[#333340] flex-grow ml-4"></div>
          
          <!-- Filters -->
          <div class="flex gap-2 font-data-label text-[12px]">
            <button class="px-3 py-1.5 bg-secondary/10 border border-secondary text-secondary rounded-sm shadow-[0_0_10px_rgba(0,238,252,0.2)] transition-all">All</button>
            <button class="px-3 py-1.5 border border-[#333340] text-on-surface-variant hover:border-primary hover:text-primary rounded-sm transition-all">Combat</button>
            <button class="px-3 py-1.5 border border-[#333340] text-on-surface-variant hover:border-primary hover:text-primary rounded-sm transition-all">Racing</button>
          </div>
        </div>
        
        <div class="terminal-card rounded-sm overflow-hidden p-0">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="font-data-label text-[10px] text-on-surface-variant tracking-widest uppercase border-b border-[#333340] bg-[#1a1a1f]/50 terminal-header">
                  <th class="p-4 font-normal">Activity Name</th>
                  <th class="p-4 font-normal">Location</th>
                  <th class="p-4 font-normal">Rewards</th>
                  <th class="p-4 font-normal">Affinity Buff</th>
                  <th class="p-4 font-normal text-right">Status</th>
                </tr>
              </thead>
              <tbody class="font-data-label text-[12px]">
                {activities.map((activity) => (
                  <tr class={`border-b border-[#333340] hover:bg-primary/5 transition-colors cursor-pointer group relative ${activity.bgColorClass || ''}`}>
                    <td class="p-4 relative">
                      <div class={`absolute left-0 top-0 bottom-0 w-1 ${activity.shadowClass} scale-y-0 group-hover:scale-y-100 transition-transform origin-center`}></div>
                      <div class="flex items-center gap-3">
                        <div class={`w-8 h-8 rounded-sm bg-[#0a0a0c] border border-[#333340] flex items-center justify-center text-on-surface-variant transition-colors ${activity.colorClass}`}>
                          <span class="material-symbols-outlined text-sm">{activity.icon}</span>
                        </div>
                        <span class="text-on-surface font-bold">{activity.name}</span>
                      </div>
                    </td>
                    <td class="p-4 text-on-surface-variant">{activity.location}</td>
                    <td class={`p-4 font-bold ${activity.rewardColorClass}`}>{activity.reward}</td>
                    <td class="p-4">
                      <span class={`px-2 py-0.5 rounded-sm border text-[10px] uppercase tracking-wider ${activity.buffClass}`}>
                        {activity.buff}
                      </span>
                    </td>
                    <td class="p-4 text-right">
                      <span class={`material-symbols-outlined transition-colors ${activity.statusClass ? activity.statusClass + ' text-on-surface-variant' : 'text-[#333340] group-hover:text-on-surface-variant'}`}>
                        {activity.statusIcon}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>
