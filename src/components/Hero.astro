<section class="relative min-h-[500px] flex flex-col justify-center overflow-hidden border-b border-primary/20 bg-transparent">
    <!-- Background Image Layer -->
    <div class="absolute inset-0 z-0 opacity-30">
        <img alt="GTA 6 Hero Background" class="w-full h-full object-cover filter contrast-125 saturate-0" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB0pOAkM0jjC02xtyTqtmymqb6ENmYmXc-ziq76OXJiOqijDdEUokzus0GDUUIGOKrje03j6pvuz6jo6a7tW6VuxOBzq4TE-UlQOmG3KFQr7GDP8ipfJ7TjTTZfBgshqyFYXYAMu_SGbhy-F4zCz7IofQTddwYWeSHGhF7X2rToitEt18AvOpSNKblFLrRCf12dKNAhyFySZrdKgWPpNmRJapoqupkCwAU66IFQ85fyvN8F4Do9ctQgWbyQfxZjFuj5itzYU8FnUCE">
        <div class="absolute inset-0 bg-gradient-to-b from-background/90 via-background/80 to-background"></div>
    </div>
    <div class="relative z-10 flex flex-col items-center justify-center w-full max-w-5xl mx-auto text-center px-4 py-16 h-full">
        <div class="font-data-label text-secondary-container text-xs tracking-[0.3em] uppercase mb-4 flex items-center gap-2">
            <span class="w-2 h-2 bg-primary rounded-full animate-pulse shadow-[0_0_8px_rgba(255,0,189,0.8)]"></span>
            System Status: Online / ETA Calculated
        </div>
        <h1 class="font-headline-lg-mobile md:font-headline-lg text-[32px] md:text-[56px] text-white font-black leading-tight mb-8 drop-shadow-xl uppercase tracking-tight">
            Grand Theft Auto <span class="text-primary drop-shadow-[0_0_10px_rgba(255,0,189,0.8)]">VI</span> releases on <br><span class="text-secondary-container font-data-label text-[24px] md:text-[40px] tracking-widest drop-shadow-[0_0_10px_rgba(0,238,252,0.8)]">November 19, 2026</span>
        </h1>
        <div class="flex flex-wrap justify-center gap-3 md:gap-8 mb-8 relative border border-primary/30 p-6 bg-[#1a1a1f]/70 backdrop-blur-md rounded-sm">
            <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary"></div>
            <div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-primary"></div>
            <div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-primary"></div>
            <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary"></div>
            
            <div class="flex flex-col items-center justify-center min-w-[80px] md:min-w-[100px]">
                <div class="font-data-label text-[40px] md:text-[64px] font-bold leading-none mb-1 text-secondary-container drop-shadow-[0_0_15px_rgba(0,238,252,0.6)]">166</div>
                <div class="font-data-label text-[12px] text-primary uppercase tracking-[0.2em] font-semibold">Days</div>
            </div>
            <div class="font-data-label text-[40px] md:text-[64px] font-bold text-[#333340] self-start mt-2">:</div>
            
            <div class="flex flex-col items-center justify-center min-w-[80px] md:min-w-[100px]">
                <div class="font-data-label text-[40px] md:text-[64px] font-bold leading-none mb-1 text-primary drop-shadow-[0_0_15px_rgba(255,0,189,0.6)]">04</div>
                <div class="font-data-label text-[12px] text-secondary-container uppercase tracking-[0.2em] font-semibold">Hours</div>
            </div>
            <div class="font-data-label text-[40px] md:text-[64px] font-bold text-[#333340] self-start mt-2">:</div>
            
            <div class="flex flex-col items-center justify-center min-w-[80px] md:min-w-[100px]">
                <div class="font-data-label text-[40px] md:text-[64px] font-bold leading-none mb-1 text-primary drop-shadow-[0_0_15px_rgba(255,0,189,0.6)]">31</div>
                <div class="font-data-label text-[12px] text-secondary-container uppercase tracking-[0.2em] font-semibold">Mins</div>
            </div>
            <div class="font-data-label text-[40px] md:text-[64px] font-bold text-[#333340] self-start mt-2">:</div>
            
            <div class="flex flex-col items-center justify-center min-w-[80px] md:min-w-[100px]">
                <div class="font-data-label text-[40px] md:text-[64px] font-bold leading-none mb-1 text-primary drop-shadow-[0_0_15px_rgba(255,0,189,0.6)]">06</div>
                <div class="font-data-label text-[12px] text-secondary-container uppercase tracking-[0.2em] font-semibold">Secs</div>
            </div>
        </div>
        <button class="bg-primary/10 hover:bg-primary/20 text-primary border border-primary font-data-label text-[14px] uppercase tracking-wider px-8 py-3 rounded-sm transition-all duration-300 flex items-center justify-center gap-2 hover:shadow-[0_0_15px_rgba(255,0,189,0.4)]">
            <span class="material-symbols-outlined text-[18px]">calendar_today</span> Init Sync <span class="material-symbols-outlined text-[18px]">expand_more</span>
        </button>
    </div>
</section>
