---
interface Rumor {
    status: string;
    image: string;
    text: string;
    source: string;
    confidence: number;
}

const rumors: Rumor[] = [
    {
        status: "UNVERIFIED",
        image: "https://lh3.googleusercontent.com/aida-public/AB6AXuADm6H38CDaF-zuEXOGWmA56lcDyExkJJwBKeLY2nUEjGWw_rqbnogUglqI92LjzCW27Hm5bM6iUeiDVCY79DeltpXq-6wT576AxJZmVqDvsJERtW5nrdfYnjMzpFj0B9EvFeXGeskxcFSRumsYE7WbD-8J_lYClrebQShZj1VO9V50rgPHl4hqk8yOm6WqmHzATeH1ETEYkuKgC351fbRUO1FMH6lUB0yvZDY7zupxqEUPnD9jvjGUEItt0WAvo66SBDU_I4mwrGU",
        text: "Encrypted chatter suggests Trailer 3 might drop mid-2025, revealing the full extent of Leonida's map and confirming Vice City's surrounding counties.",
        source: "GTAS_Relay_Alpha",
        confidence: 34
    }
];
---

<div class="terminal-card rounded-sm flex flex-col">
    <div class="terminal-header px-4 py-2 flex items-center justify-between">
        <span class="font-data-label text-[10px] text-yellow-500 uppercase tracking-widest">&gt; INTERCEPTED_RUMORS</span>
        <span class="w-2 h-2 bg-yellow-500 rounded-full animate-pulse shadow-[0_0_8px_rgba(234,179,8,0.8)]"></span>
    </div>
    <div class="p-4 flex flex-col gap-4">
        {rumors.map((rumor) => (
            <div class="bg-[#0a0a0c]/50 border border-[#333340] rounded-sm overflow-hidden flex hover:border-yellow-500/50 transition-colors">
                <div class="w-1/3 relative border-r border-[#333340]">
                    <img alt="Rumor Intel" loading="lazy" class="w-full h-full object-cover opacity-60 mix-blend-luminosity" src={rumor.image}>
                    <div class="absolute inset-0 bg-yellow-500/10 mix-blend-overlay"></div>
                </div>
                <div class="w-2/3 p-3 flex flex-col">
                    <span class="text-yellow-500 font-data-label text-[8px] uppercase tracking-wider mb-1">[{rumor.status}]</span>
                    <p class="font-body-md text-[12px] text-on-surface-variant line-clamp-3">{rumor.text}</p>
                    <div class="flex items-center gap-2 mt-auto pt-2 border-t border-[#333340] font-data-label text-[10px] text-[#333340]">
                        <span>Source: {rumor.source}</span>
                        <span>|</span>
                        <span>Confidence: {rumor.confidence}%</span>
                    </div>
                </div>
            </div>
        ))}
    </div>
</div>
