const categories = [...new Set(updates.map(u => u.type))];
---

<div class="col-span-12">
    <div class="terminal-card rounded-sm">
        <div class="terminal-header px-4 py-2 flex items-center justify-between">
            <span class="font-data-label text-[10px] text-secondary-container uppercase tracking-widest">&gt; DB_UPDATES.RECENT</span>
            <div class="flex gap-2">
                {categories.map(category => (
                    <button class="text-[10px] font-data-label text-on-surface-variant hover:text-primary uppercase tracking-wider">[{category}]</button>
                ))}
            </div>
        </div>
        <div class="p-4 grid grid-cols-2 md:grid-cols-4 gap-4">
            {updates.map((update) => (
                <a class={`bg-[#0a0a0c]/50 border border-[#333340] hover:border-${update.colorClass} rounded-sm overflow-hidden group transition-colors flex flex-col h-full relative`} href={update.link}>
                    <div class="absolute top-0 right-0 p-1 z-10">
                        <span class={`bg-${update.colorClass} text-black font-data-label text-[8px] px-1 uppercase font-bold ${update.colorClass === 'primary' ? 'shadow-[0_0_8px_rgba(var(--color-primary),0.5)]' : update.colorClass === 'secondary' ? 'shadow-[0_0_8px_rgba(var(--color-secondary),0.5)]' : 'shadow-[0_0_8px_rgba(var(--color-tertiary),0.5)]'}`}>
                            {update.typeLabel}
                        </span>
                    </div>
                    <div class="h-24 overflow-hidden border-b border-[#333340]">
                        <img alt={update.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-60 group-hover:opacity-100 mix-blend-luminosity group-hover:mix-blend-normal" src={update.image}>
                    </div>
                    <div class="p-3 flex-1 flex flex-col justify-center bg-[#1a1a1f]/30">
                        <h4 class={`font-data-label text-[12px] font-bold text-white group-hover:text-${update.colorClass} transition-colors text-center`}>{update.title}</h4>
                    </div>
                </a>
            ))}
        </div>
    </div>
</div>
