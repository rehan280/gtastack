---
/**
 * Renders a JSON-LD <script> block. Pass any schema.org object as `schema`.
 * Structured data is critical for SEO rich results and AEO — it lets search
 * and answer engines parse facts about the site directly.
 */
export interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}
const { schema } = Astro.props;
const json = JSON.stringify(schema);
---

<script type="application/ld+json" set:html={json} is:inline />
